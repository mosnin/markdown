{
  "name": "markdown",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "mcp": "tsx src/server/mcp/index.ts",
    "build:mcp": "tsc --project tsconfig.mcp.json",
    "test:e2e": "playwright test",
    "workers:dev": "cd workers/diff-worker && wrangler dev & cd workers/bundle-cache-worker && wrangler dev",
    "workers:deploy": "cd workers/diff-worker && wrangler deploy && cd workers/bundle-cache-worker && wrangler deploy"
  },
