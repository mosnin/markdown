# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321  # Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key      # Public anon key (used client- and server-side)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Server-only service role key (bypasses RLS)

# ─── Auth / App URL ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000          # Base URL for auth callbacks and links
NEXT_PUBLIC_CANONICAL_URL=                         # (optional) Explicit canonical origin for OAuth/MCP discovery
NEXT_PUBLIC_SITE_URL=                              # (optional) Legacy alias for NEXT_PUBLIC_APP_URL
NEXT_PUBLIC_API_BASE_URL=                          # (optional) Used in connection UI to build example curl commands
ADMIN_EMAILS=                                      # (optional) Comma-separated admin email addresses

# ─── OAuth / MCP ────────────────────────────────────────────────────────────
CONTEXT_STORE_LEGACY_CSK_ENABLED=false             # Enable legacy context-store key auth (true to enable)
CONTEXT_STORE_MCP_LOG_LEVEL=info                   # MCP server log level (debug | info | warn | error)

# ─── Sentry ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=                            # (optional) Sentry DSN; omit to disable error tracking

# ─── Cloudflare Workers ─────────────────────────────────────────────────────
NEXT_PUBLIC_DIFF_WORKER_URL=                       # (optional) Cloudflare diff worker URL for edge diff computation
NEXT_PUBLIC_DIFF_WORKER_SECRET=                    # (optional) Bearer token for the diff worker
NEXT_PUBLIC_BUNDLE_CACHE_URL=                      # (optional) Cloudflare bundle cache worker URL
NEXT_PUBLIC_BUNDLE_CACHE_SECRET=                   # (optional) Bearer token for the bundle cache worker

# ─── WebAuthn ───────────────────────────────────────────────────────────────
WEBAUTHN_RP_ID=localhost                           # Relying Party ID (domain, no scheme)
WEBAUTHN_RP_NAME=Poggle                            # Relying Party display name shown in passkey prompts

# ─── Cron / Internal Endpoints ──────────────────────────────────────────────
BRANCH_CLEANUP_CRON_TOKEN=                         # Shared secret for the branch cleanup cron endpoint

# ─── Billing (Creem) ────────────────────────────────────────────────────────
CREEM_API_KEY=                                     # (optional) Creem API key for billing integration
CREEM_WEBHOOK_SECRET=                              # (optional) Creem webhook signing secret
CREEM_PRO_PRODUCT_ID=                              # (optional) Creem product ID for the Pro plan

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info                                     # Application log level (debug | info | warn | error)
