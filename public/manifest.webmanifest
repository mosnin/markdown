{
  "name": "Poggle — Context Store",
  "short_name": "Poggle",
  "description": "Capture, organize, and converse with your knowledge.",
  "start_url": "/capture",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#7c3aed",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "/logo-symbol-light.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/logo-symbol-light.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/logo-symbol-light.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Quick capture",
      "short_name": "Capture",
      "url": "/capture",
      "description": "Jot a note into your Inbox"
    },
    {
      "name": "Conversation",
      "short_name": "Chat",
      "url": "/app",
      "description": "Talk to Pog"
    }
  ],
  "share_target": {
    "action": "/capture",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
