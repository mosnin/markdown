# Skip pnpm's pre-run dependency re-verification. CI installs explicitly with
# `pnpm install --frozen-lockfile`, so re-verifying before every `pnpm <script>`
# is redundant — and under newer pnpm/corepack it can spuriously re-trigger an
# install and fail the script run (ERR_PNPM_IGNORED_BUILDS). Disabling keeps
# `pnpm typecheck` / `pnpm build` etc. robust across pnpm versions.
verify-deps-before-run=false
